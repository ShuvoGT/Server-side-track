# Copy to .env and fill in. Never commit the real file.

# Bearer key for the /v1 API (dashboard and admins). At least 24 characters.
ADMIN_API_KEY=change-me-admin-key-0123456789
# Shared by the API's internal port and the gateway. At least 16 characters.
INTERNAL_API_TOKEN=change-me-internal-token-0123

# PostgreSQL password (letters and digits only: it is part of the connection URL).
POSTGRES_PASSWORD=change-me-postgres

# Signs the dashboard's session cookies (at least 32 characters).
SESSION_SECRET=change-me-session-secret-0123456789abcdef

# Optional "Continue with Google": an OAuth client (Web application) from Google Cloud Console with the redirect
# URI http://localhost:3100/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated addresses that see every workspace once they sign in with Google.
SUPER_ADMIN_EMAILS=
# Optional password reset by email: SMTP server and sender.
SMTP_URL=
MAIL_FROM=

# Host name customers CNAME their tracking subdomain to.
EDGE_HOSTNAME=edge.localhost
# Optional comma-separated edge IPv4 addresses, for customers who must use A records.
EDGE_IPV4=

# Optional: put GeoLite2-City.mmdb in ./geoip (needs a free MaxMind account) and uncomment.
# GEOIP_DB_PATH=/geoip/GeoLite2-City.mmdb
