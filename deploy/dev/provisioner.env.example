# Development only. Used by: node --env-file=deploy/dev/provisioner.env apps/provisioner/dist/server.js
# Runs Google's tagging server image on the local Docker engine. The tagging port is published on 127.0.0.1,
# so the gateway running on the host can reach it.
REDIS_URL=redis://127.0.0.1:6379
API_INTERNAL_URL=http://127.0.0.1:3001
INTERNAL_API_TOKEN=CHANGE_ME
DRIVER=docker
HOST=127.0.0.1
