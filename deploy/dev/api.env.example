# Development only. Used by: node --env-file=deploy/dev/api.env apps/api/dist/server.js
# PostgreSQL: docker run -d --name sst-postgres -e POSTGRES_USER=sst -e POSTGRES_PASSWORD=sst -e POSTGRES_DB=sst -p 127.0.0.1:5432:5432 postgres:17-alpine
DATABASE_URL=postgresql://sst:sst@127.0.0.1:5432/sst
# Comma-separated; super-admin rights need a Google sign-in with the address.
SUPER_ADMIN_EMAILS=
# Encrypts two-step verification keys (any long random string); defaults to one derived from ADMIN_API_KEY.
SECRETS_KEY=
# Optional password reset by email, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=
DASHBOARD_URL=http://localhost:3100
ADMIN_API_KEY=CHANGE_ME
INTERNAL_API_TOKEN=CHANGE_ME
EDGE_HOSTNAME=edge.localhost
EDGE_IPV4=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379
TAGGING_UPSTREAM_TEMPLATE=http://127.0.0.1:18080
HOST=127.0.0.1
