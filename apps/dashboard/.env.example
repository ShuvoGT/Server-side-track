# Copy to .env.local for `pnpm dev`.
API_URL=http://localhost:3000
ADMIN_API_KEY=change-me-admin-key-0123456789
# At least 32 random characters; signs the session cookie.
SESSION_SECRET=change-me-session-secret-0123456789abcdef
DASHBOARD_URL=http://localhost:3100
# Optional "Continue with Google" (redirect URI http://localhost:3100/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
