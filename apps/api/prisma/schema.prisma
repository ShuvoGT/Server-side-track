// Control plane configuration. PostgreSQL is the source of truth; Redis only caches routes for the gateway.
// Change this file only together with a migration: pnpm --filter @sst/api prisma:migrate --name <change>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A workspace: the account that owns containers. Users reach it through memberships.
model Tenant {
  id          String       @id
  name        String
  createdAt   DateTime     @default(now())
  containers  Container[]
  memberships Membership[]
  invites     Invite[]
}

/// A person who signs in to the dashboard, with a password, Google, or both.
model User {
  id                String          @id
  /// Lower-case.
  email             String          @unique
  name              String
  /// scrypt hash; null for Google-only accounts.
  passwordHash      String?
  googleSub         String?         @unique
  /// True once Google confirmed the address. Invites and super-admin rights need a verified address.
  emailVerified     Boolean         @default(false)
  createdAt         DateTime        @default(now())
  lastLoginAt       DateTime?
  /// Sessions signed in before this are no longer accepted.
  passwordChangedAt DateTime?
  memberships       Membership[]
  passwordResets    PasswordReset[]
}

/// A password reset link sent by email. Only the token's SHA-256 is stored; each link works once, for an hour.
model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  owner
  member
}

model Membership {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role     @default(member)
  createdAt DateTime @default(now())

  @@id([userId, tenantId])
  @@index([tenantId])
}

/// An invitation by email, turned into a membership when someone with that verified address signs in.
model Invite {
  id        String   @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  role      Role     @default(member)
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([email])
}

enum ContainerStatus {
  pending
  provisioning
  active
  failed
  deleting
}

model Container {
  id              String          @id
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  name            String
  /// GTM server container id, from the Container Config.
  gtmContainerId  String
  /// Base64 Container Config passed to the tagging servers as CONTAINER_CONFIG.
  containerConfig String
  /// Web container served by the custom loader (gtm.js).
  webContainerId  String?
  status          ContainerStatus @default(pending)
  statusMessage   String?
  upstreamUrl     String
  loaderGtmPath   String
  loaderGtagPath  String
  webhookPath     String
  webhookSecret   String
  powerUps        Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  domains         Domain[]
  usage           UsageHour[]

  @@index([tenantId])
}

enum DomainStatus {
  pending
  verified
  failed
}

model Domain {
  id            String       @id
  containerId   String
  container     Container    @relation(fields: [containerId], references: [id], onDelete: Cascade)
  hostname      String       @unique
  status        DomainStatus @default(pending)
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())

  @@index([containerId])
}

/// Request counts per container and UTC hour, rolled up from the gateway's Redis counters.
model UsageHour {
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  hour        DateTime
  requests    Int       @default(0)
  loader      Int       @default(0)
  webhook     Int       @default(0)
  botFlagged  Int       @default(0)
  botDropped  Int       @default(0)
  errors      Int       @default(0)

  @@id([containerId, hour])
}
